{
  // LOCAL TESTING ONLY: fakes Razorpay so the full report can be unlocked without keys. Never deploy with this file.
  // Run: npx wrangler dev -c wrangler.local.jsonc
  "name": "buddhiscore-local",
  "main": "worker.local.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [{ "binding": "CODES" }, { "binding": "WHIMSI" }]
}
