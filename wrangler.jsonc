{
  // Buddhi Score: a Cloudflare Worker that serves the site folder and handles the /api payment and code calls.
  "name": "buddhiscore",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Storage for the one-time ₹29 codes. Cloudflare creates it automatically on the next deploy.
  // WHIMSI counts chat messages per paid report (20 each). Also created automatically on deploy.
  "kv_namespaces": [{ "binding": "CODES" }, { "binding": "WHIMSI" }]
}
