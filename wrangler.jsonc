{
  // Buddhi Score: a Cloudflare Worker that serves the site folder and handles the two /api payment calls.
  "name": "buddhiscore",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
